generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String    @id @default(uuid())
  email     String    @unique
  create_at DateTime  @default(now())
  singedIn  DateTime  @updatedAt
  payments  Payment[]
  profile   Profile?
}

model Payment {
  id        String   @id @default(uuid())
  amount    Int
  status    String   @default("PENDING")
  provider  String   @default("MAYAR")
  mayarId   String?
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  token     String   @unique
  user      User     @relation(fields: [userId], references: [id])
}

model MagicLink {
  id        String   @id @default(uuid())
  email     String
  token     String   @unique
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model highLight {
  id        String   @id @default(uuid())
  content   String
  createdAt DateTime @default(now())
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id])
}

model Profile {
  id         String      @id @default(uuid())
  name       String
  username   String      @unique
  avatarUrl  String?
  bio        String?
  create_at  DateTime    @default(now())
  userId     String      @unique
  isPro      Boolean     @default(false)
  orders     Order[]
  user       User        @relation(fields: [userId], references: [id])
  highLights highLight[]
  widgets    widget[]
}

model widget {
  id             String   @id @default(uuid())
  token          String
  dbID           String   @unique
  create_at      DateTime @default(now())
  profileId      String
  link           String?
  name           String?
  customAvatar   String?
  customBio      String?
  customLink     String?
  customName     String?
  customUsername String?

  
  profile        Profile  @relation(fields: [profileId], references: [id])
}

model Order {
  id              String          @id @default(uuid())
  orderId         String          @unique @db.VarChar(50)
  userId          String          @db.Uuid
  amount          Int
  status          PaymentStatus   @default(PENDING)
  provider        PaymentProvider @default(MIDTRANS)
  snapToken       String?         @db.VarChar(255)
  transactionId   String?         @db.VarChar(100)
  rawNotification Json?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  profileId       String
  profile         Profile         @relation(fields: [profileId], references: [id])
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
  CANCELED
  REFUND
}

enum PaymentProvider {
  MIDTRANS
}
